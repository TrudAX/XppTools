				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// DEV Tutorial Arcade: five HTML5 games in the extensible control <c>DEVTutorialArcadeControl</c>,
/// connected to the X++ table <c>DEVTutorialArcadeSession</c>.
/// </summary>
/// <remarks>
/// Form -> game: the action pane buttons call GameControl.startGame() / togglePause() / stopGame(),
///               the game selector calls GameControl.parmGame().
/// Game -> form: the control writes the session record and raises onSessionStarted / onScoreChanged / onSessionEnded;
///               the handlers below refresh the live score and the score grids.
/// </remarks>
[Form]
public class DEVTutorialArcadeGames extends FormRun
{
    QueryBuildRange topGameRange;
    QueryBuildRange myGameRange;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        QueryBuildDataSource qbds;

        super();

        qbds = TopScores_ds.queryBuildDataSource();
        topGameRange = qbds.addRange(fieldNum(DEVTutorialArcadeSession, Game));
        qbds.addRange(fieldNum(DEVTutorialArcadeSession, Status)).value(queryValue(DEVTutorialArcadeSessionStatus::Finished));
        qbds.addSortField(fieldNum(DEVTutorialArcadeSession, Score), SortOrder::Descending);

        qbds = MySessions_ds.queryBuildDataSource();
        myGameRange = qbds.addRange(fieldNum(DEVTutorialArcadeSession, Game));
        qbds.addRange(fieldNum(DEVTutorialArcadeSession, UserId)).value(queryValue(curUserId()));
        qbds.addSortField(fieldNum(DEVTutorialArcadeSession, RecId), SortOrder::Descending);

        GameSelector.selection(GameControl.parmGame());
        element.setGameRanges();

        // game -> X++: the control saves the session and tells the form through its delegates
        GameControl.onSessionStarted += eventhandler(element.sessionStarted);
        GameControl.onScoreChanged   += eventhandler(element.scoreChanged);
        GameControl.onSessionEnded   += eventhandler(element.sessionEnded);
    }

]]></Source>
			</Method>
			<Method>
				<Name>close</Name>
				<Source><![CDATA[
    public void close()
    {
        // a round that is still running is saved as stopped
        GameControl.onSessionEnded -= eventhandler(element.sessionEnded);
        GameControl.stopSession();

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>setGameRanges</Name>
				<Source><![CDATA[
    /// <summary>
    /// Filters the score grids on the selected game.
    /// </summary>
    public void setGameRanges()
    {
        DEVTutorialArcadeGame game = GameControl.parmGame();

        topGameRange.value(queryValue(game));
        myGameRange.value(queryValue(game));
        BestScoreCtrl.value(DEVTutorialArcadeSession::bestScore(game));
        LiveScoreCtrl.value(0);
        GameNumCtrl.value(0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>refreshScores</Name>
				<Source><![CDATA[
    /// <summary>
    /// Re-reads both score grids.
    /// </summary>
    public void refreshScores()
    {
        TopScores_ds.executeQuery();
        MySessions_ds.executeQuery();
    }

]]></Source>
			</Method>
			<Method>
				<Name>sessionStarted</Name>
				<Source><![CDATA[
    /// <summary>
    /// Subscribed to <c>DEVTutorialArcadeControl.onSessionStarted</c>: the game inserted a session record.
    /// </summary>
    public void sessionStarted(RecId _sessionRecId)
    {
        GameNumCtrl.value(DEVTutorialArcadeSession::find(_sessionRecId).GameNum);
        LiveScoreCtrl.value(0);
        MySessions_ds.executeQuery();
    }

]]></Source>
			</Method>
			<Method>
				<Name>scoreChanged</Name>
				<Source><![CDATA[
    /// <summary>
    /// Subscribed to <c>DEVTutorialArcadeControl.onScoreChanged</c>: the live score was written to the session record.
    /// </summary>
    public void scoreChanged(RecId _sessionRecId, int _score)
    {
        LiveScoreCtrl.value(_score);
        MySessions_ds.research(true);
    }

]]></Source>
			</Method>
			<Method>
				<Name>sessionEnded</Name>
				<Source><![CDATA[
    /// <summary>
    /// Subscribed to <c>DEVTutorialArcadeControl.onSessionEnded</c>: the result was saved.
    /// </summary>
    public void sessionEnded(RecId _sessionRecId, int _score, boolean _newBest)
    {
        DEVTutorialArcadeGame game = GameControl.parmGame();

        LiveScoreCtrl.value(_score);
        BestScoreCtrl.value(DEVTutorialArcadeSession::bestScore(game));
        element.refreshScores();

        if (_newBest)
        {
            info(strFmt("New personal best in %1: %2 points, saved in table DEVTutorialArcadeSession.", game, _score));
        }
    }

]]></Source>
			</Method>
