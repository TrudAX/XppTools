			<Method>
				<Name>fieldsEnabled</Name>
				<Source><![CDATA[
    public void fieldsEnabled()
    {
        DEV_CleanupDataTaskBase     cleanupTask   = DEV_CleanupTaskSettings.cleanupTask();
        container                   visibleFields = cleanupTask ? cleanupTask.getVisibleSettingsFields() : conNull();
        FormDataObject              fdo;
        int                         i;

        // the fields hidden by default are shown only for the tasks that use them
        for (i = 1; i <= conLen(initialNotVisibleFields); i++)
        {
            fdo = DEV_CleanupTaskSettings_ds.object(conPeek(initialNotVisibleFields, i));
            if (fdo)
            {
                fdo.visible(false);
            }
        }

        for (i = 1; i <= conLen(visibleFields); i++)
        {
            fdo = DEV_CleanupTaskSettings_ds.object(conPeek(visibleFields, i));
            if (fdo)
            {
                fdo.visible(true);
            }
        }

        DEV_CleanupTaskSettings_ds.object(fieldNum(DEV_CleanupTaskSettings, PerCompanySetup)).allowEdit(DEV_CleanupTaskSettings.AllowPerCompanySetup);
        DEV_CleanupTaskSettings_ds.object(fieldNum(DEV_CleanupTaskSettings, DeleteByQuery)).allowEdit(DEV_CleanupTaskSettings.AllowDeleteByQuery);
        DEV_CleanupTaskSettingsQuery_ds.object(fieldNum(DEV_CleanupTaskSettingsQuery, CleanupDataArea)).visible(DEV_CleanupTaskSettings.AllowPerCompanySetup);
        
        TabPageQuery.visible(DEV_CleanupTaskSettings.AllowDeleteByQuery);
        TabPageCompany.visible(DEV_CleanupTaskSettings.AllowPerCompanySetup && !DEV_CleanupTaskSettings.AllowDeleteByQuery);
        DisplaySQLButton.visible(DEV_CleanupTaskSettings.AllowSQLDelete);
        SQLSettings.visible(DEV_CleanupTaskSettings.AllowSQLDelete);
    }

]]></Source>
			</Method>
			<Method>
				<Name>dsGetNotVisibleFields</Name>
				<Source><![CDATA[
    private container dsGetNotVisibleFields(FormDataSource _formDataSource)
    {
        DictTable       dictTable = new DictTable(_formDataSource.table());
        DictField       dictField;
        FormDataObject  fdo;
        container       res;
        int             i, j;

        for (i = 1; i <= dictTable.fieldCnt(); i++)
        {
            dictField = new DictField(dictTable.id(), dictTable.fieldCnt2Id(i));

            if (!dictField.isSystem() && dictField.allowEdit())
            {
                for (j = 1; j <= dictField.arraySize(); j++)
                {
                    fdo = _formDataSource.object(fieldId2ext(dictField.id(), j));

                    if (fdo && !fdo.visible())
                    {
                        res += fieldId2ext(dictField.id(), j);
                    }
                }
            }
        }

        return res;
    }

]]></Source>
