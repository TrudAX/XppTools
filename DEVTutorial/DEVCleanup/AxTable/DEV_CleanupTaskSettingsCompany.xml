]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static DEV_CleanupTaskSettingsCompany find( DEV_CleanupTaskSettingsRecId _recId,
                                                    DataAreaId _cleanupDataArea,
                                                    boolean _forUpdate = false)
    {
        DEV_CleanupTaskSettingsCompany record;
    
        record.selectForUpdate(_forUpdate);

        if (_recId)
        {                
            select firstonly record
                where   record.CleanupTaskSettingsRecId == _recId
                        && record.CleanupDataArea == _cleanupDataArea;
        }
    
        return record;
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        ttsbegin;

        super();

        this.updateParentSettings();

        ttscommit;

    }

]]></Source>
			</Method>
			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    public void update()
    {
        DEV_CleanupTaskSettingsCompany     orig = this.orig();

        ttsbegin;

        super();

        if (this.commonFieldUpdated(orig))
        {
            this.updateParentSettings();
        }

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>commonFieldUpdated</Name>
				<Source><![CDATA[
    public boolean commonFieldUpdated(DEV_CleanupTaskSettingsCompany _orig)
    {
        boolean         ret;

        if (_orig.CleanupDays != this.CleanupDays
            || _orig.CleanupDateType != this.CleanupDateType
            || _orig.CleanupDate != this.CleanupDate)
        {
            ret = true;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateParentSettings</Name>
				<Source><![CDATA[
    public void updateParentSettings()
    {
        if (!this.CleanupDataArea)
        {
            DEV_CleanupTaskSettings settings = this.cleanupTaskSettings(true);

            if (settings)
            {
                settings.CleanupDays = this.CleanupDays;
                settings.CleanupDateType = this.CleanupDateType;
                settings.CleanupDate = this.CleanupDate;
                settings.update();
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>cleanupTaskSettings</Name>
				<Source><![CDATA[
    public DEV_CleanupTaskSettings cleanupTaskSettings(boolean _forupdate = false)
    {        
        DEV_CleanupTaskSettings     record;

        record.selectForUpdate(_forupdate);

        if (this.CleanupTaskSettingsRecId)
        {
            select firstonly record
                where   record.RecId == this.CleanupTaskSettingsRecId;
        }

        return record;
    }

]]></Source>
			</Method>
		</Methods>
